# 远程数仓 MCP 中台环境变量模板
# 复制到 /opt/quant_mcp/env/warehouse.env 后在服务器本地填写。
# 不得把真实密钥、Token、密码提交到 Git。

COMPOSE_PROJECT_NAME=quant_cloud_center

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=quant_warehouse
POSTGRES_USER=quant_admin
POSTGRES_PASSWORD=change_me_postgres_password

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=default
CLICKHOUSE_USER=ch_admin
CLICKHOUSE_PASSWORD=change_me_clickhouse_password

MINIO_ENDPOINT=http://minio:9000
MINIO_BROWSER_REDIRECT_URL=http://127.0.0.1:9101
MINIO_ROOT_USER=quant_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET=quant-assets

MCP_BIND_HOST=0.0.0.0
MCP_AUTH_TOKEN=change_me_mcp_token
