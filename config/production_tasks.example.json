{
  "schema_version": 1,
  "schedule": {
    "description": "每日 24:00 执行已投产策略自动化任务。Windows Task Scheduler 使用 00:00 表示每日 24:00。",
    "time": "00:00",
    "timezone": "Asia/Shanghai"
  },
  "defaults": {
    "python": "python",
    "project_dir": ".",
    "data_dir": "data_file",
    "registry_file": "strategy_library/registry.json",
    "log_dir": "logs/production_tasks",
    "signal_dir": "data_file/production_signals",
    "stop_on_failure": true
  },
  "strategies": [
    {
      "strategy_id": "prod_liq_prime_one_v20260612",
      "enabled": true,
      "description": "流动性精选一号：已投产策略，每日生成下一交易日买入/卖出信号。",
      "steps": [
        {
          "name": "export_signals",
          "command": [
            "{python}",
            "export_gm_signals.py",
            "--db",
            "{data_dir}/odb.db",
            "--table",
            "stock_predict_data_executable_5d_open_return_prod_aligned_202206_202606",
            "--start",
            "20220604",
            "--end",
            "20991231",
            "--top-k",
            "1",
            "--min-pred",
            "none",
            "--min-pred-quantile",
            "0.95",
            "--max-atr-ratio",
            "none",
            "--min-amount",
            "800000",
            "--min-turnover-rate",
            "2.0",
            "--max-total-mv",
            "1000000",
            "--max-positions",
            "1",
            "--holding-days",
            "5",
            "--weight-mode",
            "equal",
            "--target-total-pct",
            "0.98",
            "--output",
            "{signal_dir}/{strategy_id}_latest.csv"
          ]
        }
      ]
    }
  ]
}
